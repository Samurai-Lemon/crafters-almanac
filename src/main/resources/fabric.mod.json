{
	"schemaVersion": 1,
	"id": "craftersalmanac",
	"version": "${version}",
	"name": "Crafter's Almanac",
	"description": "Browse every item and look up recipes and uses (like JEI/REI) in a panel that looks like the vanilla recipe book.",
	"authors": ["Samurai-Lemon"],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": ["com.samurailemon.craftersalmanac.CraftersAlmanac"],
		"modmenu": ["com.samurailemon.craftersalmanac.compat.ModMenuIntegration"]
	},
	"mixins": ["craftersalmanac.mixins.json"],
	"accessWidener": "craftersalmanac.accesswidener",
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
